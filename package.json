{
  "name": "shark-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Beautifully designed components built with Ark UI",
  "keywords": [
    "headless",
    "a11y",
    "react",
    "shadcn",
    "ark-ui",
    "ui",
    "components"
  ],
  "homepage": "https://shark-ui.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/sharkui-inc/shark-ui"
  },
  "license": "MIT",
  "author": "Vinicius Vicentini <viniciusvicentini@live.com>",
  "contributors": [
    {
      "name": "Vinicius Vicentini",
      "email": "viniciusvicentini@live.com",
      "url": "https://github.com/vinihvc"
    }
  ],
  "scripts": {
    "build": "pnpm registry:build && pnpm theme:build && next build",
    "dev": "next dev",
    "postinstall": "fumadocs-mdx",
    "lint:check": "ultracite check",
    "lint:fix": "ultracite fix",
    "registry:build": "tsx --tsconfig ./tsconfig.scripts.json ./scripts/build-registry.mts",
    "start": "next start",
    "test": "tsx --import ./test/setup-dom.ts --test \"test/**/*.test.ts\" \"test/**/*.test.tsx\"",
    "theme:build": "tsx --tsconfig ./tsconfig.scripts.json ./scripts/build-themes.mts",
    "typecheck": "next build"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.114",
    "@ark-ui/react": "^5.39.2",
    "@formisch/react": "^1.1.0",
    "@hookform/resolvers": "^5.9.1",
    "@internationalized/date": "3.12.4",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/rehype": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@shikijs/transformers": "^4.4.3",
    "@tanstack/ai": "^0.58.0",
    "@tanstack/ai-client": "^0.33.2",
    "@tanstack/ai-react": "^0.27.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "^9.2.4",
    "@teispace/next-themes": "^3.0.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.111",
    "clsx": "^2.1.1",
    "code-inspector-plugin": "^2.0.9",
    "date-fns": "^4.4.0",
    "front-matter": "^4.0.2",
    "fumadocs-core": "16.15.13",
    "fumadocs-mdx": "15.4.3",
    "fumadocs-ui": "16.15.13",
    "jotai": "^3.0.0",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "shiki": "^4.4.3",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "valibot": "^1.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "7.12.0"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  }
}

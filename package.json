{
  "name": "shark-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Beautifully designed components built with Ark UI",
  "keywords": [
    "headless",
    "a11y",
    "react",
    "shadcn",
    "ark-ui",
    "ui",
    "components"
  ],
  "homepage": "https://shark-ui.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/sharkui-inc/shark-ui"
  },
  "license": "MIT",
  "author": "Vinicius Vicentini <viniciusvicentini@live.com>",
  "contributors": [
    {
      "name": "Vinicius Vicentini",
      "email": "viniciusvicentini@live.com",
      "url": "https://github.com/vinihvc"
    }
  ],
  "scripts": {
    "build": "pnpm registry:build && pnpm theme:build && next build",
    "dev": "next dev",
    "postinstall": "fumadocs-mdx",
    "lint:check": "ultracite check",
    "lint:fix": "ultracite fix",
    "registry:build": "tsx --tsconfig ./tsconfig.scripts.json ./scripts/build-registry.mts",
    "start": "next start",
    "test": "tsx --import ./test/setup-dom.ts --test \"test/**/*.test.ts\" \"test/**/*.test.tsx\"",
    "theme:build": "tsx --tsconfig ./tsconfig.scripts.json ./scripts/build-themes.mts",
    "typecheck": "next build",
    "typecheck:tsrs": "tsrs --noEmit --fast"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.166",
    "@ark-ui/react": "^5.40.0",
    "@formisch/react": "^1.2.0",
    "@hookform/resolvers": "^7.0.2",
    "@internationalized/date": "3.12.4",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/rehype": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "@shikijs/transformers": "^4.6.0",
    "@tanstack/ai": "^1.0.1",
    "@tanstack/ai-client": "^1.0.1",
    "@tanstack/ai-react": "^1.0.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/redact": "^0.3.0",
    "@teispace/next-themes": "^3.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.162",
    "clsx": "^2.1.1",
    "code-inspector-plugin": "^2.0.9",
    "date-fns": "^4.4.0",
    "fumadocs-core": "16.17.10",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.10",
    "jotai": "^3.0.1",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.67.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "shiki": "^4.6.0",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.1",
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "tsrs": "0.21.0-ts7.1.0-beta",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "8.1.1"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  }
}
